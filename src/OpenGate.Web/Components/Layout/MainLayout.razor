@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject BrandingProvider BrandingProvider
@inject IInvoiceService InvoiceService

<AuthorizeView>
    <Authorized Context="authCtx">
        <div class="og-shell">
            <aside class="og-sidebar">
                <a class="og-sidebar-brand" href="/">
                    @if (_branding.HasLogo)
                    {
                        <img src="@_branding.LogoUrl" alt="@_branding.SiteName" style="height: 22px;" />
                    }
                    else
                    {
                        <span class="brand-dot"></span>
                    }
                    <span>@_branding.SiteName</span>
                </a>

                <div class="og-sidebar-section">Client area</div>
                <ul class="nav">
                    <li><NavLink class="nav-link" href="/" Match="NavLinkMatch.All"><i class="bi bi-grid-1x2"></i> Overview</NavLink></li>
                    <li><NavLink class="nav-link" href="/my/orders" Match="NavLinkMatch.Prefix"><i class="bi bi-hdd-rack"></i> Services</NavLink></li>
                    <li>
                        <NavLink class="nav-link" href="/my/invoices" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-receipt"></i> Billing
                            @if (_dueCount > 0)
                            {
                                <span class="badge badge-due">@_dueCount</span>
                            }
                        </NavLink>
                    </li>
                    <li><NavLink class="nav-link" href="/my/tickets" Match="NavLinkMatch.Prefix"><i class="bi bi-life-preserver"></i> Support</NavLink></li>
                    <li><NavLink class="nav-link" href="/store" Match="NavLinkMatch.Prefix"><i class="bi bi-bag-plus"></i> Order new</NavLink></li>
                </ul>

                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminCtx">
                        <div class="og-sidebar-section">Administration</div>
                        <ul class="nav">
                            <li><NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All"><i class="bi bi-speedometer2"></i> Dashboard</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/products" Match="NavLinkMatch.Prefix"><i class="bi bi-box-seam"></i> Products</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/categories" Match="NavLinkMatch.Prefix"><i class="bi bi-tags"></i> Categories</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/orders" Match="NavLinkMatch.Prefix"><i class="bi bi-cart-check"></i> Orders</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/tickets" Match="NavLinkMatch.Prefix"><i class="bi bi-chat-square-text"></i> Tickets</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/users" Match="NavLinkMatch.Prefix"><i class="bi bi-people"></i> Users</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/settings" Match="NavLinkMatch.Prefix"><i class="bi bi-sliders"></i> Settings</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/tax-rates" Match="NavLinkMatch.Prefix"><i class="bi bi-percent"></i> Tax rates</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/theme" Match="NavLinkMatch.Prefix"><i class="bi bi-palette"></i> Theme</NavLink></li>
                            <li><NavLink class="nav-link" href="/admin/migration" Match="NavLinkMatch.Prefix"><i class="bi bi-arrow-left-right"></i> Migration</NavLink></li>
                        </ul>
                    </Authorized>
                </AuthorizeView>

                <div class="og-sidebar-footer">
                    <ul class="nav">
                        <li><NavLink class="nav-link" href="/my/profile" Match="NavLinkMatch.Prefix"><i class="bi bi-person-circle"></i> Profile</NavLink></li>
                        <li><a class="nav-link" href="/logout"><i class="bi bi-box-arrow-right"></i> Sign out</a></li>
                    </ul>
                </div>
            </aside>

            <header class="og-topbar">
                <div class="og-search">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Search services, invoices, tickets…" aria-label="Search" />
                </div>
                <div class="og-topbar-actions">
                    <a class="og-icon-btn" href="/cart" title="Cart">
                        <i class="bi bi-bag"></i>
                        @if (_cartCount > 0)
                        {
                            <span class="dot"></span>
                        }
                    </a>
                    <a class="og-icon-btn" href="/my/tickets" title="Support">
                        <i class="bi bi-bell"></i>
                    </a>
                    <a class="og-user" href="/my/profile">
                        <span class="og-avatar">@_initials</span>
                        <span class="d-none d-md-inline">@_userName</span>
                    </a>
                </div>
            </header>

            <main class="og-main">
                @Body
            </main>

            <footer class="og-footer">
                @_branding.FooterText
            </footer>
        </div>
    </Authorized>
    <NotAuthorized>
        <nav class="og-nav navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid px-3">
                <a class="navbar-brand" href="/">
                    @if (_branding.HasLogo)
                    {
                        <img src="@_branding.LogoUrl" alt="@_branding.SiteName" style="height: 24px; margin-right: 0.35rem;" />
                    }
                    else
                    {
                        <span class="brand-dot"></span>
                    }
                    @_branding.SiteName
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/store" Match="NavLinkMatch.Prefix">Store</NavLink>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/login">Sign in</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/register">
                                <span class="btn btn-primary btn-sm">Get started</span>
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="og-main">
            @Body
        </main>

        <footer class="og-footer">
            @_branding.FooterText
        </footer>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _userName = "";
    private string _initials = "U";
    private int _cartCount;
    private int _dueCount;
    private BrandingInfo _branding = new();

    [Inject] private CartService CartService { get; set; } = default!;

    /// <summary>
    /// Loads branding, cached user identity, cart count, and the count of unpaid
    /// invoices so the sidebar can surface a billing badge when funds are owed.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _branding = await BrandingProvider.GetAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.Identity.Name ?? "Account";
            _initials = BuildInitials(_userName);

            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                try
                {
                    var invoices = await InvoiceService.GetByUserAsync(userId);
                    _dueCount = invoices.Count(i =>
                        i.Status == OpenGate.Domain.Enums.InvoiceStatus.Unpaid ||
                        i.Status == OpenGate.Domain.Enums.InvoiceStatus.Overdue);
                }
                catch
                {
                    _dueCount = 0;
                }
            }
        }

        _cartCount = CartService.Count;
        CartService.OnChange += () =>
        {
            _cartCount = CartService.Count;
            InvokeAsync(StateHasChanged);
        };
    }

    /// <summary>
    /// Produces up to two uppercase initials from a name or email-style identifier
    /// for display in the avatar pill.
    /// </summary>
    private static string BuildInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var at = name.IndexOf('@');
        var local = at > 0 ? name[..at] : name;
        var parts = local.Split(new[] { ' ', '.', '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return char.ToUpperInvariant(local[0]).ToString();
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[^1][0]));
    }
}
