@page "/my/invoices"
@attribute [Authorize]
@inject IInvoiceService InvoiceService
@inject AuthenticationStateProvider AuthStateProvider
@inject CurrencyProvider CurrencyProvider

<PageTitle>Billing - OpenGate</PageTitle>

<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h1>Billing</h1>
        <p class="text-muted mb-0">Invoices and payment history.</p>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else
{
    @if (_dueAmount > 0)
    {
        <div class="due-banner">
            <span class="due-icon"><i class="bi bi-exclamation-triangle"></i></span>
            <div class="due-text">
                <strong>@_currency.Format(_dueAmount)</strong> outstanding across @_dueCount invoice@(_dueCount == 1 ? "" : "s").
                @if (_overdueCount > 0)
                {
                    <small><span class="status-dot suspended"></span>@_overdueCount overdue</small>
                }
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card @(_dueAmount > 0 ? "stat-due" : "") h-100">
                <div class="card-body">
                    <span class="stat-icon"><i class="bi bi-cash-coin"></i></span>
                    <div class="stat-label">Outstanding</div>
                    <div class="stat-value font-mono">@_currency.Format(_dueAmount)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card stat-revenue h-100">
                <div class="card-body">
                    <span class="stat-icon"><i class="bi bi-check2-circle"></i></span>
                    <div class="stat-label">Paid (lifetime)</div>
                    <div class="stat-value font-mono">@_currency.Format(_paidLifetime)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <span class="stat-icon"><i class="bi bi-receipt"></i></span>
                    <div class="stat-label">Invoices</div>
                    <div class="stat-value">@_invoices.Count</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <span class="stat-icon"><i class="bi bi-calendar-event"></i></span>
                    <div class="stat-label">Next due</div>
                    <div class="stat-value" style="font-size: 1.05rem; padding-top: 0.4rem;">
                        @(_nextDue?.ToString("MMM d, yyyy") ?? "—")
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!_invoices.Any())
    {
        <div class="empty-state">
            <i class="bi bi-receipt d-block"></i>
            <h5>No invoices</h5>
            <p class="mb-0">You don't have any invoices yet.</p>
        </div>
    }
    else
    {
        <div class="filter-bar">
            @foreach (var f in _filters)
            {
                <button class="filter-btn @(_filter == f.Key ? "active" : "")" @onclick='() => _filter = f.Key'>
                    @f.Label <span class="ms-1 text-muted" style="font-weight: 400;">@CountFor(f.Key)</span>
                </button>
            }
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Order</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Due</th>
                            <th>Paid</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in FilteredInvoices)
                        {
                            var overdue = inv.Status == InvoiceStatus.Unpaid && inv.DueDate.Date < DateTime.UtcNow.Date;
                            <tr>
                                <td>
                                    <div class="font-mono" style="font-weight: 500;">@inv.InvoiceNumber</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@inv.CreatedAt.ToString("MMM d, yyyy")</div>
                                </td>
                                <td><a href="/my/orders/@inv.OrderId" class="text-muted"><code class="font-mono">@TruncateId(inv.OrderId)</code></a></td>
                                <td><span class="font-mono">@_currency.Format(inv.Total)</span></td>
                                <td>
                                    @if (overdue)
                                    {
                                        <span class="badge badge-status status-overdue">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status status-@inv.Status.ToString().ToLowerInvariant()">@inv.Status</span>
                                    }
                                </td>
                                <td>
                                    @inv.DueDate.ToString("MMM d, yyyy")
                                    @if (inv.Status == InvoiceStatus.Unpaid)
                                    {
                                        <div class="text-muted" style="font-size: 0.7rem;">@RelativeDue(inv.DueDate)</div>
                                    }
                                </td>
                                <td>@(inv.PaidAt?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 align-items-center justify-content-end">
                                        <a href="/api/invoices/@inv.Id/pdf" target="_blank" class="btn btn-sm btn-outline-secondary" title="Download PDF">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                        @if (inv.Status != InvoiceStatus.Paid && inv.Status != InvoiceStatus.Cancelled && inv.Status != InvoiceStatus.Refunded)
                                        {
                                            <a href="/my/invoices/@inv.Id/pay" class="btn btn-sm @(overdue ? "btn-danger" : "btn-primary")">Pay</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<InvoiceDto> _invoices = new();
    private CurrencyInfo _currency = new();
    private bool _loading = true;
    private string? _errorMessage;
    private string _filter = "all";

    private decimal _dueAmount;
    private decimal _paidLifetime;
    private int _dueCount;
    private int _overdueCount;
    private DateTime? _nextDue;

    private record FilterOption(string Key, string Label);
    private static readonly FilterOption[] _filters =
    {
        new("all", "All"),
        new("unpaid", "Unpaid"),
        new("paid", "Paid"),
        new("refunded", "Refunded"),
        new("cancelled", "Cancelled")
    };

    private IEnumerable<InvoiceDto> FilteredInvoices => _filter switch
    {
        "unpaid" => _invoices.Where(i => i.Status == InvoiceStatus.Unpaid || i.Status == InvoiceStatus.Overdue),
        "paid" => _invoices.Where(i => i.Status == InvoiceStatus.Paid),
        "refunded" => _invoices.Where(i => i.Status == InvoiceStatus.Refunded),
        "cancelled" => _invoices.Where(i => i.Status == InvoiceStatus.Cancelled),
        _ => _invoices
    };

    private int CountFor(string key) => key switch
    {
        "all" => _invoices.Count,
        "unpaid" => _invoices.Count(i => i.Status == InvoiceStatus.Unpaid || i.Status == InvoiceStatus.Overdue),
        "paid" => _invoices.Count(i => i.Status == InvoiceStatus.Paid),
        "refunded" => _invoices.Count(i => i.Status == InvoiceStatus.Refunded),
        "cancelled" => _invoices.Count(i => i.Status == InvoiceStatus.Cancelled),
        _ => 0
    };

    protected override async Task OnInitializedAsync()
    {
        _currency = await CurrencyProvider.GetAsync();
        await LoadInvoicesAsync();
    }

    private async Task LoadInvoicesAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                _invoices = (await InvoiceService.GetByUserAsync(userId))
                    .OrderByDescending(i => i.CreatedAt).ToList();

                var unpaid = _invoices
                    .Where(i => i.Status == InvoiceStatus.Unpaid || i.Status == InvoiceStatus.Overdue)
                    .ToList();
                _dueCount = unpaid.Count;
                _dueAmount = unpaid.Sum(i => i.Total);
                _overdueCount = _invoices.Count(i =>
                    i.Status == InvoiceStatus.Overdue ||
                    (i.Status == InvoiceStatus.Unpaid && i.DueDate.Date < DateTime.UtcNow.Date));
                _paidLifetime = _invoices.Where(i => i.Status == InvoiceStatus.Paid).Sum(i => i.Total);
                _nextDue = unpaid.OrderBy(i => i.DueDate).Select(i => (DateTime?)i.DueDate).FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string TruncateId(string id) => id.Length > 8 ? id[..8] + "…" : id;

    private static string RelativeDue(DateTime due)
    {
        var days = (int)(due.Date - DateTime.UtcNow.Date).TotalDays;
        if (days == 0) return "due today";
        if (days > 0) return $"in {days} day{(days == 1 ? "" : "s")}";
        return $"{-days} day{(days == -1 ? "" : "s")} overdue";
    }
}
