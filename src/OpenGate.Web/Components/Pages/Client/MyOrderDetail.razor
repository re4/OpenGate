@page "/my/orders/{Id}"
@attribute [Authorize]
@inject IOrderService OrderService
@inject IInvoiceService InvoiceService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject CurrencyProvider CurrencyProvider

<PageTitle>Order @(_order?.Id ?? "") - OpenGate</PageTitle>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_order == null || !_isOwner)
{
    <div class="empty-state">
        <i class="bi bi-shield-x d-block"></i>
        <h5>Order not found</h5>
        <p class="mb-3">This order does not exist or you don't have access to it.</p>
        <a href="/my/orders" class="btn btn-primary">Back to My Orders</a>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/my/orders">Services</a></li>
            <li class="breadcrumb-item active">@(_order.Items.FirstOrDefault()?.ProductName ?? "Service")</li>
        </ol>
    </nav>

    <div class="card mb-4" style="background: linear-gradient(135deg, var(--bg-surface), var(--bg-elevated));">
        <div class="card-body" style="padding: 1.25rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div class="d-flex align-items-start gap-3">
                    <span style="width: 48px; height: 48px; border-radius: 10px; background: var(--accent-muted); color: var(--accent-hover); display: inline-flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-hdd-rack"></i>
                    </span>
                    <div>
                        <div style="font-size: 1.15rem; font-weight: 600; color: var(--text); letter-spacing: -0.2px;">
                            @(FirstItem?.ProductName ?? "Service")
                        </div>
                        <div class="text-muted" style="font-size: 0.75rem; font-family: var(--font-mono); margin-top: 0.15rem;">
                            #@Id
                        </div>
                        <div class="d-flex gap-2 align-items-center mt-2">
                            <span class="badge badge-status status-@_order.Status.ToString().ToLowerInvariant()">@_order.Status</span>
                            @if (_order.NextDueDate.HasValue && _order.Status == OrderStatus.Active)
                            {
                                <span class="text-muted" style="font-size: 0.75rem;">
                                    <i class="bi bi-calendar-event me-1"></i>Renews @_order.NextDueDate.Value.ToString("MMM d, yyyy")
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-column align-items-end gap-2">
                    <div style="font-size: 1.1rem; font-weight: 600; font-family: var(--font-mono); color: var(--text);">
                        @_currency.Format(_order.Total)<small class="text-muted" style="font-weight: 400; font-size: 0.75rem;">@CycleSuffix(FirstItem?.BillingCycle)</small>
                    </div>
                    <div class="d-flex gap-2">
                        @if (_unpaidInvoices.Count > 0)
                        {
                            <a href="/my/invoices/@_unpaidInvoices[0].Id/pay" class="btn btn-sm btn-danger">
                                <i class="bi bi-credit-card me-1"></i> Pay @_currency.Format(_unpaidInvoices.Sum(i => i.Total))
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(_order.ProvisioningId) && _order.Status == OrderStatus.Active)
                        {
                            <a href="/my/orders/@Id/server" class="btn btn-sm btn-primary">
                                <i class="bi bi-hdd-rack me-1"></i> Manage server
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Service contents</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _order.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td><span class="font-mono">@_currency.Format(item.UnitPrice)</span></td>
                                    <td><span class="font-mono">@_currency.Format(item.Total)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Subtotal</span>
                        <span class="font-mono">@_currency.Format(_order.Subtotal)</span>
                    </div>
                    @if (_order.Tax > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 text-muted">
                            <span>Tax</span>
                            <span class="font-mono">@_currency.Format(_order.Tax)</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total</span>
                        <span class="font-mono">@_currency.Format(_order.Total)</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_order.Notes))
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h6>Notes</h6>
                        <p class="mb-0 text-muted">@_order.Notes</p>
                    </div>
                </div>
            }
        </div>
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Related Invoices</h5>
                </div>
                <div class="card-body">
                    @if (_invoices.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var inv in _invoices)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <span class="font-mono">@inv.InvoiceNumber</span>
                                        <span class="badge badge-status status-@inv.Status.ToString().ToLowerInvariant() ms-2">@inv.Status</span>
                                    </div>
                                    @if (inv.Status != InvoiceStatus.Paid)
                                    {
                                        <a href="/my/invoices/@inv.Id/pay" class="btn btn-sm btn-primary">Pay</a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No invoices for this order.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private OrderDto? _order;
    private List<InvoiceDto> _invoices = new();
    private CurrencyInfo _currency = new();
    private bool _loading = true;
    private string? _errorMessage;
    private bool _isOwner;
    private string? _loadedId;

    private OrderItemDto? FirstItem => _order?.Items.FirstOrDefault();
    private List<InvoiceDto> _unpaidInvoices = new();

    private static string CycleSuffix(BillingCycle? c) => c switch
    {
        BillingCycle.Monthly => " /mo",
        BillingCycle.Quarterly => " /qtr",
        BillingCycle.SemiAnnually => " /6mo",
        BillingCycle.Annually => " /yr",
        BillingCycle.OneTime => "",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        _currency = await CurrencyProvider.GetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id) && !string.Equals(_loadedId, Id, StringComparison.Ordinal))
        {
            _loadedId = Id;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _errorMessage = null;
        _isOwner = false;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                _loading = false;
                return;
            }

            _order = await OrderService.GetByIdAsync(Id);
            if (_order != null)
            {
                _isOwner = _order.UserId == userId;
                if (_isOwner)
                {
                    _invoices = (await InvoiceService.GetByOrderAsync(Id)).ToList();
                    _unpaidInvoices = _invoices
                        .Where(i => i.Status == InvoiceStatus.Unpaid || i.Status == InvoiceStatus.Overdue)
                        .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

}
