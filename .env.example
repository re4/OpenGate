# Copy this to `.env` and fill the values in. `docker compose up -d` reads it
# automatically.

# The release tag of the OpenGate image to run. Bumping this is the only
# supported way to upgrade -- the image only exists for git release tags.
# Find available tags at https://github.com/Mirin/OpenGate/pkgs/container/opengate
OPENGATE_VERSION=v0.1.0

# Host port to expose the app on.
OPENGATE_PORT=8080

# MongoDB credentials. Pick a long random password.
MONGO_ROOT_USER=opengate
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string
MONGO_DB_NAME=OpenGate

# First-run admin account. If you leave both blank a strong random password
# will be generated and printed to the container log on first start (look for
# "Generated bootstrap admin password").
OPENGATE_ADMIN_EMAIL=
OPENGATE_ADMIN_PASSWORD=
